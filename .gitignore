# Node modules
node_modules/
**/node_modules/

# Environment files (do NOT commit secrets)
.env
*.env
**/.env

# Test artifacts / results - omit large or local-only test outputs
/test-results/
/frontend/test-results/
screenshots/
**/screenshots/
/frontend/playwright-report/
/frontend/blob-report/

# Playwright / e2e local files
/frontend/e2e/mock-server.cjs
/frontend/e2e/mock-server.js

# Local build artifacts
/frontend/dist/

# Local editor / OS / IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore local logs
*.log

# Ignore temporary files
tmp/
temp/
*.tmp
temp_token.txt

# Temporary build & swap artifacts (VPS updater & swap files)
cmp-build-swap*
**/cmp-build-swap*
cmp_backup_*
cmp_update_*
cmp-updater-*.sh
cmp-backup-*.json

# Backups & dead code
*.bak
*.bak.*
**/backup/
* - Copy.*

# Ignore uploaded files (user avatars, etc.)
backend/public/uploads/*
!backend/public/uploads/.gitkeep
!backend/public/uploads/README.md

# Ignore custom logos (user-uploaded, persisted outside git)
backend/public/logos/*
!backend/public/logos/.gitkeep

# Ignore runtime token map data
backend/data/token_map.json

# Local release draft notes (permanent notes live on GitHub Releases & RELEASE_NOTES.md)
release-notes-*.md