# Ensure shell scripts and config files use LF line endings on all platforms.
# Git for Windows (core.autocrlf=true) would otherwise convert them to CRLF,
# which breaks bash execution (e.g. "$'\r'" errors).
*.sh text eol=lf
*.bash text eol=lf
*.conf text eol=lf
*.conf.templ text eol=lf
*.service text eol=lf
*.md text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yml text eol=lf

# Windows PowerShell scripts keep CRLF (harmless) but normalize to LF in repo.
*.ps1 text eol=lf